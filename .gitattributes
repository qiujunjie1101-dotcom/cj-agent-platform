# 默认按文本处理并统一换行为 LF
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.so binary
*.dll binary
*.exe binary

# 平台相关脚本使用对应换行符
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# 语言识别（便于 diff / 统计）
*.json text
*.yml  text
*.yaml text
*.md   text