# 环境变量示例：复制为 .env 后填写真实值（.env 不会被提交到仓库）
# docker/docker-compose.yml 会读取 MYSQL_ROOT_PASSWORD、REDIS_PASSWORD、
# MINIO_ROOT_USER 和 MINIO_ROOT_PASSWORD

# ---------- 应用 ----------
APP_NAME=CJ Agent Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# 可选值：text / json
LOG_FORMAT=text

# ---------- MySQL ----------
# 本机 3306 已被原生 MySQL 占用，Docker 版 MySQL 映射到宿主机 3307
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=cj
# 账号统一为 root / root
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
# SQLAlchemy 连接串（按需选用）
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3307/cj?charset=utf8mb4

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis123456
# 无密码时使用 redis://127.0.0.1:6379/0
REDIS_URL=redis://:redis123456@127.0.0.1:6379/0

# ---------- MinIO ----------
# S3 兼容 API：http://127.0.0.1:9000
# Web 管理控制台：http://127.0.0.1:9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
